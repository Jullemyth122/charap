# AI Provider Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Auth Secrets (32+ character random string)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# Google Cloud SQL (PostgreSQL Connection String)
DATABASE_URL=postgresql://postgres:password@your_cloud_sql_ip:5432/charap_db?sslmode=require

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Upstash Redis (Optional Rate Limiting Cache)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
